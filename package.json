    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0"
